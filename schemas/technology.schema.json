{
  "$defs": {
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "area_um2": {
          "minimum": 0,
          "title": "Area Um2",
          "type": "number"
        },
        "fixed_energy_pj": {
          "minimum": 0,
          "title": "Fixed Energy Pj",
          "type": "number"
        },
        "latency_ns": {
          "minimum": 0,
          "title": "Latency Ns",
          "type": "number"
        }
      },
      "required": [
        "area_um2",
        "fixed_energy_pj",
        "latency_ns"
      ],
      "title": "Costs",
      "type": "object"
    },
    "Detector": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "detector",
          "title": "Kind",
          "type": "string"
        },
        "model_version": {
          "const": "scalar_intensity_v1",
          "title": "Model Version",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "minItems": 1,
          "title": "Ports",
          "type": "array"
        },
        "operating_envelope": {
          "$ref": "#/$defs/OperatingEnvelope"
        },
        "costs": {
          "$ref": "#/$defs/Costs"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceBindings"
        },
        "notes": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Notes",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/DetectorParameters"
        }
      },
      "required": [
        "id",
        "kind",
        "model_version",
        "ports",
        "operating_envelope",
        "costs",
        "evidence",
        "notes",
        "parameters"
      ],
      "title": "Detector",
      "type": "object"
    },
    "DetectorParameters": {
      "additionalProperties": false,
      "properties": {
        "minimum_full_scale_power_mw": {
          "exclusiveMinimum": 0,
          "title": "Minimum Full Scale Power Mw",
          "type": "number"
        },
        "quantum_efficiency": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Quantum Efficiency",
          "type": "number"
        },
        "input_referred_noise_mw_rms": {
          "minimum": 0,
          "title": "Input Referred Noise Mw Rms",
          "type": "number"
        }
      },
      "required": [
        "minimum_full_scale_power_mw",
        "quantum_efficiency",
        "input_referred_noise_mw_rms"
      ],
      "title": "DetectorParameters",
      "type": "object"
    },
    "Encoding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "normalized_intensity",
          "default": "normalized_intensity",
          "title": "Id",
          "type": "string"
        },
        "optical_quantity": {
          "const": "power_mw",
          "default": "power_mw",
          "title": "Optical Quantity",
          "type": "string"
        },
        "electrical_quantity": {
          "const": "normalized_sample",
          "default": "normalized_sample",
          "title": "Electrical Quantity",
          "type": "string"
        },
        "logical_minimum": {
          "default": 0.0,
          "maximum": 0,
          "minimum": 0,
          "title": "Logical Minimum",
          "type": "number"
        },
        "logical_maximum": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 1,
          "title": "Logical Maximum",
          "type": "number"
        },
        "interpretation": {
          "const": "P(t)=full_scale_power_mw*x; 0<=x<=1",
          "default": "P(t)=full_scale_power_mw*x; 0<=x<=1",
          "title": "Interpretation",
          "type": "string"
        },
        "energy_accounting": {
          "const": "full_scale_per_symbol_upper_bound",
          "default": "full_scale_per_symbol_upper_bound",
          "title": "Energy Accounting",
          "type": "string"
        }
      },
      "title": "Encoding",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "illustrative_assumption",
            "model_reference",
            "measurement",
            "simulation",
            "standard",
            "review_report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Citation",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "coverage": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Coverage",
          "type": "string"
        },
        "limitations": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "citation",
        "version",
        "coverage",
        "limitations"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceBindings": {
      "additionalProperties": false,
      "description": "Each key covers every leaf of that group; references do not calibrate values.",
      "properties": {
        "parameters": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "operating_envelope": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Operating Envelope",
          "type": "array"
        },
        "costs": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Costs",
          "type": "array"
        },
        "model": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Model",
          "type": "array"
        }
      },
      "required": [
        "parameters",
        "operating_envelope",
        "costs",
        "model"
      ],
      "title": "EvidenceBindings",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "title": "Minimum",
          "type": "number"
