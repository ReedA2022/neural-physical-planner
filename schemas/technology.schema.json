        "temperature_c": {
          "$ref": "#/$defs/Interval"
        },
        "symbol_duration_ns": {
          "$ref": "#/$defs/Interval"
        },
        "max_input_power_mw": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
