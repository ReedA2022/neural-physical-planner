      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "components": {
      "items": {
        "discriminator": {
          "mapping": {
            "detector": "#/$defs/Detector",
            "modulator": "#/$defs/Modulator",
            "source": "#/$defs/Source",
            "splitter": "#/$defs/Splitter",
            "waveguide": "#/$defs/Waveguide"
