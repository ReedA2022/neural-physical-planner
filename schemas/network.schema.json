{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Lower",
          "type": "array"
        },
        "upper": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Upper",
          "type": "array"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "input",
            "linear",
            "relu",
            "add",
            "identity"
          ],
          "title": "Op",
          "type": "string"
        },
        "inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "weights": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        },
        "bias": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bias"
        },
        "input_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "op",
        "size"
      ],
      "title": "Node",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "outputs": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    }
  },
  "required": [
    "name",
    "nodes",
    "outputs"
  ],
  "title": "Network",
  "type": "object"
}
